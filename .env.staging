NODE_ENV=staging
PORT=3000

# En staging/production estos valores deben venir de un gestor de
# secretos (no de un archivo commiteado) — se deja el archivo como
# plantilla de las variables que hacen falta, no con valores reales.
DB_HOST=__SET_IN_SECRETS_MANAGER__
DB_PORT=5432
DB_USERNAME=__SET_IN_SECRETS_MANAGER__
DB_PASSWORD=__SET_IN_SECRETS_MANAGER__
DB_DATABASE=taxi_pilot_staging

REDIS_HOST=__SET_IN_SECRETS_MANAGER__
REDIS_PORT=6379

JWT_SECRET=__SET_IN_SECRETS_MANAGER__
